.DS_Store
Thumbs.db

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Happy Birthday, Abeni!</title>
    <meta
      name="description"
      content="A warm and creative birthday tribute for Abeni from Dagi Addis."
    />
    <link rel="stylesheet" href="style.css" />
  </head>
  <body>
    <div class="confetti-layer" id="confettiLayer" aria-hidden="true"></div>
    <div class="balloons" aria-hidden="true">
      <span class="balloon balloon-one"></span>
      <span class="balloon balloon-two"></span>
      <span class="balloon balloon-three"></span>
      <span class="balloon balloon-four"></span>
    </div>

    <main class="birthday-card">
      <header class="hero">
        <p class="eyebrow">A special wish from Dagi Addis to Abeni</p>
        <h1>Happy Birthday, Abeni!</h1>
        <p class="subtitle">May your life bloom with laughter, love, unforgettable memories, and endless joy.</p>

        <div class="cta-row">
          <button id="surpriseBtn" class="primary-btn">Open Birthday Surprise</button>
        </div>
      </header>

      <section class="story-grid">
        <div class="photo-panel">
          <img src="IMG_9343.jpg" alt="Abeni and Dagi Addis celebrating together" />
          <div class="badge">Best Brother Ever</div>
        </div>

        <div class="letter">
          <h2>To Abeni, My Amazing Brother</h2>
          <p>
            Every year, you remind me how special you are with your smile, your kindness, and the love you carry in your heart.
            You are more than a brother—you are family, a friend, and a source of happiness in so many memories.
          </p>
          <p>
            From Dagi Addis, I want to wish you endless joy, successful dreams, good health, and a future full of beautiful moments.
          </p>
          <p>
            Even if life ever changes in ways we cannot imagine, you will always remain a precious part of my heart and a beautiful replacement of love, kindness, and family for my brother.
          </p>
        </div>
      </section>

      <section class="reasons">
        <h3>Why Abeni Is So Special</h3>
        <div class="reason-list">
          <div class="reason-box">
            <span>💙</span>
            <p>You make every day brighter and full of warmth.</p>
          </div>
          <div class="reason-box">
            <span>🎉</span>
            <p>You bring fun, laughter, and unforgettable joy.</p>
          </div>
          <div class="reason-box">
            <span>🌟</span>
            <p>You shine with love, strength, and beautiful dreams.</p>
          </div>
        </div>
      </section>

      <section id="hiddenMessage" class="hidden-message" aria-live="polite">
        <div class="wish-header">
          <h3>Birthday Surprise for Abeni</h3>
          <p class="sender">From Dagi Addis</p>
        </div>

        <div id="galleryGrid" class="gallery-grid" aria-label="Birthday photo gallery"></div>

        <div id="lightbox" class="lightbox" aria-hidden="true">
          <button id="lightboxClose" class="lightbox-close" aria-label="Close image">×</button>
          <button id="lightboxPrev" class="lightbox-nav prev" aria-label="Previous image">‹</button>
          <img id="lightboxImage" src="" alt="Expanded birthday memory" />
          <button id="lightboxNext" class="lightbox-nav next" aria-label="Next image">›</button>
        </div>

        <p>
          May your dreams come true, may your days be filled with peace, and may every step you take lead you to a life full of love and success.
          Even when life feels heavy, remember you are deeply loved, deeply valued, and forever treasured in my heart like a brother's lasting replacement of love and family.
          Keep smiling, keep shining, and keep being the incredible person you are.
        </p>
        <p class="signoff">Love always, Dagi Addis ❤️</p>
      </section>
    </main>

    <footer class="footer">
      <p>Made with love for Abeni.</p>
      <p>© <span id="year"></span> Happy Birthday</p>
    </footer>

    <script src="script.js"></script>
  </body>
</html>
